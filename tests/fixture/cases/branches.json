[
    {
        "description": "a $ref branch over an object checks the definition's fields",
        "schema": {
            "type": "object",
            "$defs": { "HasA": { "required": ["a"] } },
            "properties": { "a": { "type": "integer" }, "b": { "type": "integer" } },
            "anyOf": [{ "$ref": "#/$defs/HasA" }, { "required": ["b"] }]
        },
        "tests": [
            { "description": "the definition's branch", "data": { "a": 1 }, "valid": true, "failures": [] },
            { "description": "the other branch", "data": { "b": 1 }, "valid": true, "failures": [] },
            { "description": "neither", "data": {}, "valid": false, "failures": ["Value: range"] }
        ]
    },
    {
        "description": "an allOf branch over an object holds where each subschema does",
        "schema": {
            "type": "object",
            "properties": { "a": { "type": "integer" }, "b": { "type": "integer" } },
            "anyOf": [{ "allOf": [{ "required": ["a"] }, { "required": ["b"] }] }, { "properties": { "a": { "minimum": 10 } }, "required": ["a"] }]
        },
        "tests": [
            { "description": "both fields", "data": { "a": 1, "b": 2 }, "valid": true, "failures": [] },
            { "description": "a large a alone", "data": { "a": 10 }, "valid": true, "failures": [] },
            { "description": "a small a alone", "data": { "a": 1 }, "valid": false, "failures": ["Value: range"] }
        ]
    },
    {
        "description": "anyOf over an object checks the fields each branch names",
        "schema": {
            "type": "object",
            "properties": { "a": { "type": "integer" }, "b": { "type": "string" } },
            "anyOf": [{ "required": ["a"] }, { "properties": { "b": { "minLength": 2 } }, "required": ["b"] }]
        },
        "tests": [
            { "description": "the first branch", "data": { "a": 1 }, "valid": true, "failures": [] },
            { "description": "the second branch", "data": { "b": "xy" }, "valid": true, "failures": [] },
            { "description": "neither", "data": { "b": "x" }, "valid": false, "failures": ["Value: range"] },
            { "description": "nothing", "data": {}, "valid": false, "failures": ["Value: range"] }
        ]
    },
    {
        "description": "oneOf over an object fails where both branches hold, once at the object",
        "schema": {
            "type": "object",
            "properties": { "a": { "type": "integer", "minimum": 0 }, "b": { "type": "integer" } },
            "oneOf": [{ "required": ["a"] }, { "required": ["b"] }]
        },
        "tests": [
            { "description": "one", "data": { "a": 1 }, "valid": true, "failures": [] },
            { "description": "both", "data": { "a": 1, "b": 2 }, "valid": false, "failures": ["Value: range"] },
            { "description": "a field's own check fails apart from the branches", "data": { "a": -1 }, "valid": false, "failures": ["Value.a: range"] }
        ]
    },
    {
        "description": "a branch over a nested object names that object's fields",
        "schema": {
            "type": "object",
            "properties": {
                "o": {
                    "type": "object",
                    "properties": { "kind": { "type": "string" }, "n": { "type": "integer" } },
                    "if": { "properties": { "kind": { "const": "count" } } },
                    "then": { "required": ["n"] },
                    "else": { "properties": { "n": false } }
                }
            }
        },
        "tests": [
            { "description": "a count with its number", "data": { "o": { "kind": "count", "n": 3 } }, "valid": true, "failures": [] },
            { "description": "a count without one", "data": { "o": { "kind": "count" } }, "valid": false, "failures": ["Value.o: range"] },
            { "description": "another kind without one", "data": { "o": { "kind": "flag" } }, "valid": true, "failures": [] },
            { "description": "another kind with one", "data": { "o": { "kind": "flag", "n": 1 } }, "valid": false, "failures": ["Value.o: range"] }
        ]
    },
    {
        "description": "a branch over an object reaches into a field's object",
        "schema": {
            "type": "object",
            "properties": {
                "o": { "type": "object", "properties": { "n": { "type": "integer" } } }
            },
            "anyOf": [
                { "properties": { "o": { "properties": { "n": { "minimum": 10 } }, "required": ["n"] } } },
                { "properties": { "o": { "properties": { "n": { "maximum": 0 } } } } }
            ]
        },
        "tests": [
            { "description": "large", "data": { "o": { "n": 12 } }, "valid": true, "failures": [] },
            { "description": "small", "data": { "o": { "n": -1 } }, "valid": true, "failures": [] },
            { "description": "between", "data": { "o": { "n": 5 } }, "valid": false, "failures": ["Value: range"] },
            { "description": "absent, which the second branch allows", "data": { "o": {} }, "valid": true, "failures": [] }
        ]
    },
    {
        "description": "oneOf and anyOf judge null by the branches that admit it",
        "schema": {
            "type": "object",
            "properties": {
                "one": { "type": ["integer", "null"], "oneOf": [{ "type": "integer" }, { "minimum": 5 }] },
                "int": { "type": ["integer", "null"], "oneOf": [{ "type": "integer" }] },
                "any": { "type": ["integer", "null"], "anyOf": [{ "type": "integer" }, { "type": "string" }] },
                "nul": { "type": ["integer", "null"], "anyOf": [{ "type": "null" }, { "maximum": 0 }] }
            }
        },
        "tests": [
            { "description": "null in one branch of oneOf", "data": { "one": null }, "valid": true, "failures": [] },
            { "description": "null in no branch of oneOf", "data": { "int": null }, "valid": false, "failures": ["Value.int: range"] },
            { "description": "an integer in both", "data": { "one": 7 }, "valid": false, "failures": ["Value.one: range"] },
            { "description": "null in no branch of anyOf", "data": { "any": null }, "valid": false, "failures": ["Value.any: range"] },
            { "description": "null in a null branch", "data": { "nul": null }, "valid": true, "failures": [] },
            { "description": "an integer in no branch", "data": { "nul": 1 }, "valid": false, "failures": ["Value.nul: range"] }
        ]
    },
    {
        "description": "a branch over a list checks its count and items",
        "schema": {
            "type": "object",
            "properties": {
                "xs": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "anyOf": [{ "maxItems": 1 }, { "type": "array", "items": { "type": "integer", "minimum": 0 } }]
                }
            }
        },
        "tests": [
            { "description": "short", "data": { "xs": [-1] }, "valid": true, "failures": [] },
            { "description": "long, every item at least zero", "data": { "xs": [0, 3] }, "valid": true, "failures": [] },
            { "description": "long, an item below zero", "data": { "xs": [1, -3] }, "valid": false, "failures": ["Value.xs: range"] }
        ]
    },
    {
        "description": "a branch over an object names a key its fields lack",
        "schema": {
            "type": "object",
            "properties": { "a": { "type": "integer" } },
            "oneOf": [{ "required": ["b"] }]
        },
        "tests": [
            {
                "description": "the key is absent",
                "data": { "a": 1 },
                "valid": false,
                "failures": ["Value: range"]
            },
            {
                "description": "the key is present",
                "data": { "a": 1, "b": 2 },
                "valid": true,
                "failures": []
            }
        ]
    }
]
